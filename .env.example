# Mobile URL belongs in mobile/.env.local; root Expo/public settings do not configure the mobile app.
# Public URL only. API secrets belong on the secure AI service, never in Expo.
# Full endpoint, not a base URL. Leave empty for deterministic on-device answers.
EXPO_PUBLIC_AI_PROXY_URL="https://your-secure-service.example/api/mobile-chat"

# Server only (root .env.local), never an EXPO_PUBLIC_* value:
# GROQ_API_KEY="your-server-key"
# GROQ_MODEL="openai/gpt-oss-120b"
